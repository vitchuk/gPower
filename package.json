{
  "name": "gpower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,mcp -c blue,green,magenta \"npm run dev -w @gpower/server\" \"npm run dev -w @gpower/web\" \"npm run dev -w @gpower/mcp-catalog\"",
    "dev:api": "npm run dev -w @gpower/server",
    "dev:web": "npm run dev -w @gpower/web",
    "dev:mcp": "npm run dev -w @gpower/mcp-catalog",
    "build": "npm run build -w @gpower/web",
    "index": "npm run index -w @gpower/server",
    "summaries": "npm run summaries -w @gpower/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
